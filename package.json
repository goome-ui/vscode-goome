{
  "name": "vscode-goome",
  "displayName": "goome",
  "description": "Snippets, a new project command, a .goome.json preview and hover docs for goome, the see-through overlay and ui library.",
  "version": "0.5.1",
  "publisher": "goome-ui",
  "license": "GPL-3.0-only",
  "icon": "media/icon.png",
  "homepage": "https://goome-ui.github.io/docs/",
  "repository": {
    "type": "git",
    "url": "https://github.com/goome-ui/vscode-goome"
  },
  "bugs": {
    "url": "https://github.com/goome-ui/vscode-goome/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Snippets",
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "goome",
    "overlay",
    "ui",
    "immediate mode",
    "gui"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:goome",
    "onLanguage:goome-theme"
  ],
  "contributes": {
    "configuration": {
      "title": "goome",
      "properties": {
        "goome.cli": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `goome` or `goome.py` for **goome: New Project**. Empty = `goome` on PATH, or else goome.py from the latest goome-cli release."
        },
        "goome.python": {
          "type": "string",
          "default": "",
          "markdownDescription": "Python to run goome.py with. Empty = `python3`, `python` or `py -3`."
        }
      }
    },
    "commands": [
      {
        "command": "goome.newProject",
        "title": "New Project",
        "category": "goome",
        "icon": "$(new-folder)"
      },
      {
        "command": "goome.openPreview",
        "title": "Open Preview",
        "category": "goome",
        "icon": "$(open-preview)"
      },
      {
        "command": "goome.copyCode",
        "title": "Copy Code From This Project",
        "category": "goome"
      },
      {
        "command": "goome.openBuilder",
        "title": "Open UI Builder",
        "category": "goome",
        "icon": "$(layout)"
      },
      {
        "command": "goome.searchDocs",
        "title": "Search Docs",
        "category": "goome",
        "icon": "$(search)"
      },
      {
        "command": "goome.openDocs",
        "title": "Open Docs",
        "category": "goome",
        "icon": "$(book)"
      },
      {
        "command": "goome.refreshSidebar",
        "title": "Refresh",
        "category": "goome",
        "icon": "$(refresh)"
      },
      {
        "command": "goome.openFile",
        "title": "Open goome File",
        "category": "goome"
      },
      {
        "command": "goome.insertSnippet",
        "title": "Insert Snippet",
        "category": "goome"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "goome.openPreview",
          "when": "resourceFilename =~ /\\.goome\\.json$/"
        },
        {
          "command": "goome.copyCode",
          "when": "resourceFilename =~ /\\.goome\\.json$/"
        },
        {
          "command": "goome.openFile",
          "when": "false"
        },
        {
          "command": "goome.insertSnippet",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "goome.openPreview",
          "when": "resourceFilename =~ /\\.goome\\.json$/ && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "goome.newProject",
          "when": "view == goome.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "goome.searchDocs",
          "when": "view == goome.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "goome.refreshSidebar",
          "when": "view == goome.sidebar || view == goome.files",
          "group": "navigation@9"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "goome",
          "title": "goome",
          "icon": "media/goome-bar.svg"
        }
      ]
    },
    "views": {
      "goome": [
        {
          "id": "goome.sidebar",
          "name": "goome",
          "icon": "media/goome-bar.svg",
          "contextualTitle": "goome"
        }
      ],
      "explorer": [
        {
          "id": "goome.files",
          "name": "goome",
          "icon": "media/goome-bar.svg",
          "contextualTitle": "goome files"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "goome.files",
        "contents": "No .goome.json or .goome-theme.json files in this workspace yet.\n[Open UI builder](command:goome.openBuilder)"
      }
    ],
    "customEditors": [
      {
        "viewType": "goome.preview",
        "displayName": "goome Preview",
        "selector": [
          {
            "filenamePattern": "*.goome.json"
          }
        ],
        "priority": "option"
      }
    ],
    "languages": [
      {
        "id": "goome",
        "aliases": [
          "goome project"
        ],
        "extensions": [
          ".goome.json"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/goome-file-light.svg",
          "dark": "./media/goome-file-dark.svg"
        }
      },
      {
        "id": "goome-theme",
        "aliases": [
          "goome theme"
        ],
        "extensions": [
          ".goome-theme.json"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/goome-file-light.svg",
          "dark": "./media/goome-file-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "goome",
        "scopeName": "source.json.goome",
        "path": "./syntaxes/goome.tmLanguage.json"
      },
      {
        "language": "goome-theme",
        "scopeName": "source.json.goome-theme",
        "path": "./syntaxes/goome-theme.tmLanguage.json"
      }
    ],
    "jsonLanguageParticipants": [
      {
        "languageId": "goome"
      },
      {
        "languageId": "goome-theme"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "*.goome.json",
        "url": "./schemas/goome-project.schema.json"
      },
      {
        "fileMatch": "*.goome-theme.json",
        "url": "./schemas/goome-theme.schema.json"
      }
    ],
    "snippets": [
      {
        "language": "c",
        "path": "./snippets/c.json"
      },
      {
        "language": "cpp",
        "path": "./snippets/c.json"
      },
      {
        "language": "csharp",
        "path": "./snippets/csharp.json"
      },
      {
        "language": "python",
        "path": "./snippets/python.json"
      },
      {
        "language": "java",
        "path": "./snippets/java.json"
      }
    ]
  },
  "scripts": {
    "sync": "node scripts/sync.js",
    "compile": "npm run sync && tsc -p .",
    "unit": "node --test \"test/unit/*.test.js\"",
    "test": "node out/test/runTest.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "mocha": "^11.7.0",
    "typescript": "~5.9.3"
  }
}

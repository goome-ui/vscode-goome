    "description": "tabs",
    "body": [
      "${2:tab} = ui.tabs(\"${1:tabs}\", [\"${3:General}\", \"${4:Advanced}\"], $2)",
      "if $2 == 0:",
      "\t$0"
    ]
  },
  "goome collapsing": {
    "prefix": "goome-collapsing",

  "goome style": {
    "prefix": "goome-style",
    "description": "push a color and a size, popped when the with ends",
    "body": [
      "with ui.style(${1:accent}=${2:0xFFFF5050}, ${3:radius}=${4:4}):",
      "\t$0"
    ]
  },
  "goome style push": {
    "prefix": "goome-style-push",
    "description": "push and pop by hand",
    "body": [
      "ui.push_color(goome.S_${1|ACCENT,BG,PANEL,BORDER,TEXT,TEXT_DIM,HOVER,ACTIVE,INPUT_BG|}, ${2:0xFFFF5050})",
      "ui.push_num(goome.S_${3|RADIUS,PAD,GAP,BORDER_WIDTH,FONT_SIZE|}, ${4:4})",
      "$0",
      "ui.pop(2)"
    ]
  },
  "goome custom": {
    "prefix": "goome-custom",
    "description": "your own widget, a knob you drag up and down",
    "body": [
      "${1:gain} = ui.store(\"$1\", 1)",
      "it = ui.custom(\"$1\", ${2:80}, ${3:80}, goome.ITEM_DRAG_Y | goome.ITEM_FOCUSABLE)",
      "if it.held:",
      "\t$1[0] = min(1, max(0, $1[0] - it.dy / 200))",
      "c = ui.canvas",
      "if c:",
      "\tc.arc(it.x + 40, it.y + 40, 30, 6, 2.36, 2.36 + 4.71 * $1[0], ui.theme.accent)"
    ]
  },
  "goome offscreen": {
    "prefix": "goome-offscreen",
    "description": "offscreen frame: no window, push a click, save what it drew",
    "body": [
      "g = goome.open_offscreen(${1:640}, ${2:480})",
      "ui = g.ui()",
      "g.push_click(${3:60}, ${4:60})",
      "for ev in g.events(0):",
      "\tui.feed(ev)",
      "with ui.frame() as c:",
      "\tif c is not None:",
      "\t\tui.app(\"${5:offscreen}\")",
      "\t\t$0",
      "\t\tui.app_end()",
      "g.last_frame().save_ppm(\"${6:frame.ppm}\")",
      "g.close()"
    ]
  },
  "goome hotkey": {
    "prefix": "goome-hotkey",
    "description": "global hotkey and where it fires",
    "body": [
      "try:",
      "\tg.hotkey(\"${1:alt+m}\", ${2:1})",
      "except goome.GoomeError:",
      "\tpass",
      "$0",
      "if ev.type == goome.HOTKEY and ev.id == $2:",
      "\tpass"
    ]
  },
  "goome theme preset": {
    "prefix": "goome-theme-preset",
    "description": "use a built in theme",
    "body": [
      "ui.theme.preset(goome.PRESET_${1|DARK,LIGHT,MIDNIGHT,PAPER,MINT,HIGH_CONTRAST,ROSE|})"
    ]
  },
  "goome theme make": {
    "prefix": "goome-theme-make",
    "description": "make a theme from one accent color",
    "body": [
      "ui.theme.make(${1:0xFF4FA3FF}, ${2:True}, ${3:10})"
    ]
  }
}

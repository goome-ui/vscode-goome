    ]
  },
  "goome table": {
    "prefix": "goome-table",
    "description": "table with sortable columns",
    "body": [
      "with ui.table(\"${1:files}\", 2, ${2:200}, goome.TABLE_SORTABLE | goome.TABLE_STRIPES) as t:",
      "\tif t.shown:",
      "\t\tt.column(\"${3:Name}\")",
      "\t\tt.column(\"${4:Size}\", 90)",
      "\t\tfor i, row in enumerate(${5:rows}):",
      "\t\t\tt.row()",
      "\t\t\tui.label(str(i))",
      "\t\t\tt.next()",
      "\t\t\tui.label(str(row))$0"
    ]
  },

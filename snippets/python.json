    ]
  },
  "goome menubar": {
    "prefix": "goome-menubar",
    "description": "menu bar with a File menu",
    "body": [
      "with ui.menubar() as bar:",
      "\tif bar:",
      "\t\twith ui.menu(\"${1:File}\") as menu:",
      "\t\t\tif menu:",
      "\t\t\t\tif ui.menu_item(\"${2:Open}\", \"${3:Ctrl+O}\"):",
      "\t\t\t\t\t$0",
      "\t\t\t\tui.menu_separator()",
      "\t\t\t\tif ui.menu_item(\"Quit\", \"Ctrl+Q\"):",
      "\t\t\t\t\trunning = False"
    ]
  },
  "goome popup": {
    "prefix": "goome-popup",
    "description": "button that opens a popup",
    "body": [
      "if ui.button(\"${1:More}\"):",
      "\tui.popup_open(\"${2:more}\")",
      "with ui.popup(\"$2\") as shown:",
      "\tif shown:",
      "\t\t$0"
    ]
  },
  "goome context": {
    "prefix": "goome-context",
    "description": "right click menu for the widget before it",
    "body": [
      "with ui.context(\"${1:ctx}\") as shown:",
      "\tif shown and ui.menu_item(\"${2:Delete}\"):",
      "\t\t$0"
    ]
  },
  "goome modal": {
    "prefix": "goome-modal",
    "description": "modal with a Done button, settings_open is a goome.Flag",
    "body": [
      "if ui.button(\"${1:Open settings}\"):",
      "\t${2:settings_open}.value = True",
      "with ui.modal(\"${3:Settings}\", $2) as shown:",
      "\tif shown:",
      "\t\t$0",
      "\t\tif ui.button(\"Done\"):",
      "\t\t\tui.popup_close()"
    ]
  },
  "goome toast": {
    "prefix": "goome-toast",
    "description": "toast message",

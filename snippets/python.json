{
  "goome overlay": {
    "prefix": "goome-overlay",
    "description": "open a see-through overlay with a ui window",
    "body": [
      "import sys",
      "",
      "import goome",
      "",
      "",
      "def main():",
      "\ttry:",
      "\t\tg = goome.open(\"${1:my overlay}\")",
      "\texcept goome.GoomeError as e:",
      "\t\tprint(\"couldnt open an overlay: %s\" % e, file=sys.stderr)",
      "\t\treturn 1",
      "\tui = g.ui()",
      "\twin = goome.Window(60, 60, 280)",
      "\twhile win.open:",
      "\t\tfor ev in g.events(16):",
      "\t\t\tif ev.type == goome.QUIT:",
      "\t\t\t\twin.open = False",
      "\t\t\tui.feed(ev)",
      "\t\tif not win.open or ui.begin(0) is None:",
      "\t\t\tcontinue",
      "\t\tif ui.window(\"$1\", win, goome.WIN_MOVE | goome.WIN_CLOSE):",
      "\t\t\tui.label(\"${2:im on top of everything}\")",
      "\t\t\t$0",
      "\t\tui.window_end()",
      "\t\tui.end()",
      "\tg.close()",
      "\treturn 0",
      "",
      "",
      "if __name__ == \"__main__\":",
      "\tsys.exit(main())"
    ]
  },
  "goome app": {
    "prefix": "goome-app",
    "description": "open a normal app window that the ui fills",
    "body": [
      "import sys",
      "",
      "import goome",
      "",
      "",
      "def main():",
      "\ttry:",
      "\t\tg = goome.open_app(\"${1:My App}\", ${2:960}, ${3:640})",
      "\texcept goome.GoomeError as e:",
      "\t\tprint(\"couldnt open a window: %s\" % e, file=sys.stderr)",
      "\t\treturn 1",
      "\tui = g.ui()",
      "\trunning = True",
      "\twhile running:",
      "\t\tfor ev in g.events(16):",
      "\t\t\tif ev.type in (goome.QUIT, goome.CLOSE):",
      "\t\t\t\trunning = False",
      "\t\t\tui.feed(ev)",
      "\t\tif not running or ui.begin(0) is None:",
      "\t\t\tcontinue",
      "\t\tui.app(\"$1\")",
      "\t\tui.heading(\"${4:Hello}\")",
      "\t\t$0",
      "\t\tui.app_end()",
      "\t\tui.end()",
      "\tg.close()",
      "\treturn 0",
      "",
      "",
      "if __name__ == \"__main__\":",
      "\tsys.exit(main())"
    ]
  },
  "goome loop": {
    "prefix": "goome-loop",
    "description": "main loop with poll and pace, only redraws when something changed",
    "body": [
      "pace = goome.Pacer(${1:60})",
      "running, dirty = True, True",
      "while running:",
      "\tbusy = dirty or ${2:ui}.animating",
      "\tfor ev in ${3:g}.events(pace.wait() if busy else 500):",
      "\t\tif ev.type in (goome.QUIT, goome.CLOSE):",
      "\t\t\trunning = False",
      "\t\t$2.feed(ev)",
      "\t\tdirty = True",
      "\tif not running:",
      "\t\tbreak",
      "\tif not (dirty or $2.animating):",
      "\t\tcontinue",
      "\tdirty = False",
      "\tif $2.begin(0) is None:",
      "\t\tcontinue",
      "\t$0",
      "\t$2.end()"
    ]
  },
  "goome window": {
    "prefix": "goome-window",
    "description": "ui window with a label and a button",
    "body": [
      "with ui.window(\"${1:Window}\", ${2:win}, goome.WIN_MOVE | goome.WIN_RESIZE | goome.WIN_COLLAPSE) as shown:",
      "\tif shown:",
      "\t\tui.label(\"${3:hello}\")",
      "\t\tif ui.button(\"${4:Click me}\"):",
      "\t\t\t$0"
    ]
  },
  "goome canvas": {
    "prefix": "goome-canvas",
    "description": "draw on the overlay yourself, no ui",
    "body": [
      "c = ${1:g}.begin(0)",
      "if c is not None:",
      "\tc.clear()",
      "\tc.round_rect(${2:40}, ${3:40}, ${4:200}, ${5:80}, 10, 0xEC1B1D22)",
      "\tc.text($2 + 12, $3 + 12, \"${6:hello}\", 0xFFE9EBEE, big=True)",
      "\t$0",
      "\t$1.end(c, [goome.Rect($2, $3, $4, $5)])"
    ]
  },
  "goome label": {
    "prefix": "goome-label",
    "description": "label",
    "body": [
      "ui.label(\"${1:some text}\")"
    ]
  },
  "goome heading": {
    "prefix": "goome-heading",

{
  "goome overlay": {
    "prefix": "goome-overlay",
    "description": "open a see-through overlay with a ui window",
    "body": [
      "import io.github.goomeui.*;",
      "",
      "public class ${1:Main} {",
      "\tpublic static void main(String[] args) {",
      "\t\tGoome g;",
      "\t\ttry {",
      "\t\t\tg = Goome.open(\"${2:my overlay}\");",
      "\t\t} catch (GoomeException e) {",
      "\t\t\tSystem.err.println(\"couldnt open an overlay: \" + e.getMessage());",
      "\t\t\tSystem.exit(1);",
      "\t\t\treturn;",
      "\t\t}",
      "\t\tUi ui = g.ui();",
      "\t\tWindow win = new Window(60, 60, 280, 0);",
      "\t\twhile (win.open()) {",
      "\t\t\tfor (Event e : g.events(16)) {",
      "\t\t\t\tif (e.type() == Goome.QUIT) win.open(false);",
      "\t\t\t\tui.feed(e);",
      "\t\t\t}",
      "\t\t\tif (!win.open() || ui.begin(0) == null) continue;",
      "\t\t\tif (ui.window(\"$2\", win, Ui.WIN_MOVE | Ui.WIN_CLOSE)) {",
      "\t\t\t\tui.label(\"${3:im on top of everything}\");",
      "\t\t\t\t$0",
      "\t\t\t}",
      "\t\t\tui.windowEnd();",
      "\t\t\tui.end();",
      "\t\t}",
      "\t\tui.close();",
      "\t\tg.close();",
      "\t}",
      "}"
    ]
  },
  "goome app": {
    "prefix": "goome-app",
    "description": "open a normal app window that the ui fills",
    "body": [
      "import io.github.goomeui.*;",
      "",
      "public class ${1:Main} {",
      "\tpublic static void main(String[] args) {",
      "\t\tGoome g;",
      "\t\ttry {",
      "\t\t\tg = Goome.openApp(\"${2:My App}\", ${3:960}, ${4:640});",
      "\t\t} catch (GoomeException e) {",
      "\t\t\tSystem.err.println(\"couldnt open a window: \" + e.getMessage());",
      "\t\t\tSystem.exit(1);",
      "\t\t\treturn;",
      "\t\t}",
      "\t\tUi ui = g.ui();",
      "\t\tboolean running = true;",
      "\t\twhile (running) {",
      "\t\t\tfor (Event e : g.events(16)) {",
      "\t\t\t\tif (e.type() == Goome.QUIT || e.type() == Goome.CLOSE) running = false;",
      "\t\t\t\tui.feed(e);",
      "\t\t\t}",
      "\t\t\tif (!running || ui.begin(0) == null) continue;",
      "\t\t\tui.app(\"$2\", 0);",
      "\t\t\tui.heading(\"${5:Hello}\");",
      "\t\t\t$0",
      "\t\t\tui.appEnd();",
      "\t\t\tui.end();",
      "\t\t}",
      "\t\tui.close();",
      "\t\tg.close();",
      "\t}",
      "}"
    ]
  },
  "goome loop": {
    "prefix": "goome-loop",
    "description": "main loop with poll and pace, only redraws when something changed",
    "body": [
      "try (Pacer pace = new Pacer(${1:60})) {",
      "\tboolean running = true, dirty = true;",
      "\twhile (running) {",
      "\t\tint wait = dirty || ${2:ui}.animating() ? pace.next() : 500;",
      "\t\tfor (Event ev = ${3:g}.poll(wait); ev != null; ev = $3.poll(0)) {",
      "\t\t\tif (ev.type() == Goome.QUIT || ev.type() == Goome.CLOSE) running = false;",
      "\t\t\t$2.feed(ev);",
      "\t\t\tdirty = true;",
      "\t\t}",
      "\t\tif (!running) break;",
      "\t\tif (!dirty && !$2.animating()) continue;",
      "\t\tdirty = false;",
      "\t\tif ($2.begin(0) == null) continue;",
      "\t\t$0",
      "\t\t$2.end();",
      "\t}",
      "}"
    ]
  },
  "goome window": {
    "prefix": "goome-window",
    "description": "ui window with a label and a button",
    "body": [
      "if (ui.window(\"${1:Window}\", ${2:win}, Ui.WIN_MOVE | Ui.WIN_RESIZE | Ui.WIN_COLLAPSE)) {",
      "\tui.label(\"${3:hello}\");",
      "\tif (ui.button(\"${4:Click me}\")) {",
      "\t\t$0",
      "\t}",
      "}",
      "ui.windowEnd();"
    ]
  },
  "goome canvas": {
    "prefix": "goome-canvas",
    "description": "draw on the overlay yourself, no ui",
    "body": [
      "Canvas c = ${1:g}.begin(0);",
      "if (c != null) {",
      "\tc.clear();",
      "\tc.roundRect(${2:40}, ${3:40}, ${4:200}, ${5:80}, 10, 0xEC1B1D22);",
      "\tc.text($2 + 12, $3 + 12, \"${6:hello}\", 0xFFE9EBEE, true);",
      "\t$0",
      "\t$1.end(c, new Rect($2, $3, $4, $5));",
      "}"
    ]
  },

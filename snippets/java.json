  "goome custom": {
    "prefix": "goome-custom",
    "description": "your own widget, a knob you drag up and down",
    "body": [
      "DoubleBuffer ${1:gain} = ui.store(\"$1\", 1);",
      "Item it = ui.custom(\"$1\", ${2:80}, ${3:80}, ItemFlag.DRAG_Y, ItemFlag.FOCUSABLE);",
      "if (it.held()) $1.put(0, Math.max(0, Math.min(1, $1.get(0) - it.dy() / 200)));",
      "Canvas c = ui.canvas();",
      "if (c != null) c.arc(it.x() + 40, it.y() + 40, 30, 6, 2.36, 2.36 + 4.71 * $1.get(0), ui.theme().accent());"
    ]
  },

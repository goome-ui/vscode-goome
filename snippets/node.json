  "goome custom": {
    "prefix": "goome-custom",
    "description": "your own widget, a knob you drag up and down",
    "body": [
      "const ${1:gain} = ui.store(\"$1\", 1);",
      "const it = ui.custom(\"$1\", ${2:80}, ${3:80}, goome.ITEM_DRAG_Y | goome.ITEM_FOCUSABLE);",
      "if (it.held) $1[0] = Math.min(1, Math.max(0, $1[0] - it.dy / 200));",
      "const c = ui.canvas;",
      "if (c) c.arc(it.x + 40, it.y + 40, 30, 6, 2.36, 2.36 + 4.71 * $1[0], ui.theme.accent);"
    ]
  },
  "goome offscreen": {
    "prefix": "goome-offscreen",
    "description": "offscreen frame: no window, push a click, save what it drew",
    "body": [
      "const g = goome.openOffscreen(${1:640}, ${2:480});",
      "const ui = g.ui();",
      "g.pushClick(${3:60}, ${4:60});",
      "for (const ev of g.events(0)) ui.feed(ev);",
      "ui.frame(0, () => {",
      "  ui.app(\"${5:offscreen}\", 0, () => {",
      "    $0",
      "  });",
      "});",
      "g.lastFrame().savePpm(\"${6:frame.ppm}\");",
      "g.close();"
    ]
  },

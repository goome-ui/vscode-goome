      "  c.clear();",
      "  c.roundRect(${2:40}, ${3:40}, ${4:200}, ${5:80}, 10, 0xec1b1d22);",
      "  c.text($2 + 12, $3 + 12, \"${6:hello}\", 0xffe9ebee, true);",
      "  $0",
      "  $1.end(c, [[$2, $3, $4, $5]]);",
      "}"
    ]
  },

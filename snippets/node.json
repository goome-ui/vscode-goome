{
  "goome overlay": {
    "prefix": "goome-overlay",
    "description": "open a see-through overlay with a ui window",
    "body": [
      "\"use strict\";",
      "const goome = require(\"goome\");",
      "",
      "function main() {",
      "  let g;",
      "  try {",
      "    g = goome.open(\"${1:my overlay}\");",
      "  } catch (e) {",
      "    console.error(\"couldnt open an overlay: \" + String(e));",
      "    return 1;",
      "  }",
      "  const ui = g.ui();",
      "  const win = { x: 60, y: 60, w: 280, open: true };",
      "  while (win.open) {",
      "    for (const ev of g.events(16)) {",
      "      if (ev.type === goome.QUIT) win.open = false;",
      "      ui.feed(ev);",
      "    }",
      "    if (!win.open) break;",
      "    ui.frame(0, () => {",
      "      ui.window(\"$1\", win, goome.WIN_MOVE | goome.WIN_CLOSE, () => {",
      "        ui.label(\"${2:im on top of everything}\");",
      "        $0",
      "      });",
      "    });",
      "  }",
      "  g.close();",
      "  return 0;",
      "}",
      "",
      "process.exitCode = main();"
    ]
  },
  "goome app": {
    "prefix": "goome-app",
    "description": "open a normal app window that the ui fills",
    "body": [
      "\"use strict\";",
      "const goome = require(\"goome\");",
      "",
      "function main() {",
      "  let g;",
      "  try {",
      "    g = goome.openApp(\"${1:My App}\", ${2:960}, ${3:640});",
      "  } catch (e) {",
      "    console.error(\"couldnt open a window: \" + String(e));",
      "    return 1;",
      "  }",
      "  const ui = g.ui();",
      "  let running = true;",
      "  while (running) {",
      "    for (const ev of g.events(16)) {",
      "      if (ev.type === goome.QUIT || ev.type === goome.CLOSE) running = false;",
      "      ui.feed(ev);",
      "    }",
      "    if (!running) break;",
      "    ui.frame(0, () => {",
      "      ui.app(\"$1\", 0, () => {",
      "        ui.heading(\"${4:Hello}\");",
      "        $0",
      "      });",
      "    });",
      "  }",
      "  g.close();",
      "  return 0;",
      "}",
      "",
      "process.exitCode = main();"
    ]
  },
  "goome loop": {
    "prefix": "goome-loop",
    "description": "main loop with poll and pace, only redraws when something changed",
    "body": [
      "const pace = new goome.Pacer(${1:60});",
      "let running = true;",
      "let dirty = true;",
      "while (running) {",
      "  const busy = dirty || ${2:ui}.animating;",
      "  for (const ev of ${3:g}.events(busy ? pace.wait() : 500)) {",
      "    if (ev.type === goome.QUIT || ev.type === goome.CLOSE) running = false;",
      "    $2.feed(ev);",
      "    dirty = true;",
      "  }",
      "  if (!running) break;",
      "  if (!(dirty || $2.animating)) continue;",
      "  dirty = false;",
      "  $2.frame(0, () => {",
      "    $0",
      "  });",
      "}"
    ]
  },
  "goome window": {
    "prefix": "goome-window",
    "description": "ui window with a label and a button",

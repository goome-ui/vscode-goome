      "  ui.label(\"${3:hello}\");",
      "  if (ui.button(\"${4:Click me}\")) {",
      "    $0",
      "  }",
      "});"
    ]
  },
  "goome canvas": {
    "prefix": "goome-canvas",
    "description": "draw on the overlay yourself, no ui",
    "body": [
      "const c = ${1:g}.begin(0);",

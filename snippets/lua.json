{
  "goome overlay": {
    "prefix": "goome-overlay",
    "description": "open a see-through overlay with a ui window",
    "body": [
      "local goome = require(\"goome\")",
      "",
      "local g, err = goome.open(\"${1:my overlay}\")",
      "if not g then",
      "  io.stderr:write(\"cant open an overlay: \" .. tostring(err) .. \"\\n\")",
      "  os.exit(1)",
      "end",
      "local ui = g:ui()",
      "local win = {x = 60, y = 60, w = 280, h = 0, open = true}",
      "while win.open do",
      "  for ev in g:events(16) do",
      "    if ev.type == goome.QUIT then win.open = false end",
      "    ui:feed(ev)",
      "  end",
      "  if win.open and ui:begin(0) then",
      "    if ui:window(\"$1\", win, goome.WIN_MOVE + goome.WIN_CLOSE) then",
      "      ui:label(\"${2:im on top of everything}\")",
      "      $0",
      "    end",
      "    ui:window_end()",
      "    ui:finish()",
      "  end",
      "end",
      "g:close()"
    ]
  },
  "goome app": {
    "prefix": "goome-app",
    "description": "open a normal app window that the ui fills",
    "body": [
      "local goome = require(\"goome\")",
      "",
      "local g, err = goome.open_app(\"${1:My App}\", ${2:960}, ${3:640})",
      "if not g then",
      "  io.stderr:write(\"cant open a window: \" .. tostring(err) .. \"\\n\")",
      "  os.exit(1)",
      "end",
      "local ui = g:ui()",
      "local running = true",
      "while running do",
      "  for ev in g:events(16) do",
      "    if ev.type == goome.QUIT or ev.type == goome.CLOSE then running = false end",
      "    ui:feed(ev)",
      "  end",
      "  if running and ui:begin(0) then",
      "    ui:app(\"$1\")",
      "    ui:heading(\"${4:Hello}\")",
      "    $0",
      "    ui:app_end()",
      "    ui:finish()",
      "  end",
      "end",
      "g:close()"
    ]
  },
  "goome loop": {
    "prefix": "goome-loop",
    "description": "main loop with poll and pace, only redraws when something changed",
    "body": [
      "local pace = goome.pacer(${1:60})",
      "local running, dirty = true, true",
      "while running do",
      "  local busy = dirty or ${2:ui}:animating()",
      "  for ev in ${3:g}:events(busy and pace:wait() or 500) do",
      "    if ev.type == goome.QUIT or ev.type == goome.CLOSE then running = false end",
      "    $2:feed(ev)",
      "    dirty = true",
      "  end",
      "  if not running then break end",
      "  if dirty or $2:animating() then",
      "    dirty = false",
      "    if $2:begin(0) then",
      "      $0",
      "      $2:finish()",
      "    end",
      "  end",
      "end"
    ]
  },
  "goome window": {
    "prefix": "goome-window",
    "description": "ui window with a label and a button",
    "body": [
      "if ui:window(\"${1:Window}\", ${2:win}, goome.WIN_MOVE + goome.WIN_RESIZE + goome.WIN_COLLAPSE) then",
      "  ui:label(\"${3:hello}\")",
      "  if ui:button(\"${4:Click me}\") then",
      "    $0",
      "  end",
      "end",
      "ui:window_end()"
    ]
  },
  "goome canvas": {
    "prefix": "goome-canvas",
    "description": "draw on the overlay yourself, no ui",
    "body": [
      "local c = ${1:g}:begin(0)",
      "if c then",
      "  c:clear()",
      "  c:round_rect(${2:40}, ${3:40}, ${4:200}, ${5:80}, 10, 0xEC1B1D22)",
      "  c:text($2 + 12, $3 + 12, \"${6:hello}\", 0xFFE9EBEE, true)",
      "  $0",
      "  c:hit($2, $3, $4, $5)",
      "  $1:finish(c)",
      "end"
    ]
  },
  "goome label": {
    "prefix": "goome-label",
    "description": "label",
    "body": [
      "ui:label(\"${1:some text}\")"
    ]
  },
  "goome heading": {
    "prefix": "goome-heading",
    "description": "heading",
    "body": [
      "ui:heading(\"${1:Heading}\")"
    ]
  },
  "goome wrapped": {
    "prefix": "goome-wrapped",
    "description": "text that wraps at the edge",
    "body": [
      "ui:wrapped(\"${1:this text wraps when it runs into the edge}\")"
    ]
  },
  "goome button": {
    "prefix": "goome-button",
    "description": "button",
    "body": [
      "if ui:button(\"${1:Click me}\") then",
      "  $0",
      "end"
    ]
  },
  "goome checkbox": {
    "prefix": "goome-checkbox",
    "description": "checkbox, returns the new value",
    "body": [
      "${2:show_grid} = ui:checkbox(\"${1:Show grid}\", $2)"
    ]
  },
  "goome toggle": {
    "prefix": "goome-toggle",
    "description": "toggle switch, returns the new value",
    "body": [
      "${2:wifi} = ui:toggle(\"${1:Wi-Fi}\", $2)"
    ]
  },
  "goome radio": {
    "prefix": "goome-radio",
    "description": "radio buttons on one int",
    "body": [
      "${2:size} = ui:radio(\"${1:Small}\", $2, 0)",
      "ui:same_line()",
      "$2 = ui:radio(\"${3:Large}\", $2, 1)"
    ]
  },
  "goome slider": {
    "prefix": "goome-slider",
    "description": "slider, returns the new value",
    "body": [
      "${2:volume} = ui:slider(\"${1:Volume}\", $2, ${3:0}, ${4:1}, \"${5:%.2f}\")"
    ]
  },
  "goome slider int": {
    "prefix": "goome-slider-int",
    "description": "int slider, returns the new value",
    "body": [
      "${2:count} = ui:slider_int(\"${1:Count}\", $2, ${3:0}, ${4:100})"
    ]
  },
  "goome input": {
    "prefix": "goome-input",
    "description": "one line text input",
    "body": [
      "${2:name} = ui:input(\"${1:Name}\", $2, ${3:64})"
    ]
  },
  "goome password": {
    "prefix": "goome-password",
    "description": "password input with a hint",
    "body": [
      "${2:password} = ui:password(\"${1:Password}\", $2, \"${3:hint}\")"
    ]
  },
  "goome combo": {
    "prefix": "goome-combo",
    "description": "dropdown, items count from 1",
    "body": [
      "${2:fruit} = ui:combo(\"${1:Fruit}\", $2, {\"${3:Mango}\", \"${4:Banana}\", \"${5:Cherry}\"})"
    ]
  },
  "goome selectable": {
    "prefix": "goome-selectable",
    "description": "selectable list row",
    "body": [
      "if ui:selectable(\"${1:Item}\", ${2:picked} == ${3:1}) then",
      "  $2 = $3",
      "end"
    ]
  },
  "goome tabs": {
    "prefix": "goome-tabs",
    "description": "tabs, they count from 1",
    "body": [
      "${2:tab} = ui:tabs(\"${1:tabs}\", {\"${3:General}\", \"${4:Advanced}\"}, $2)",
      "if $2 == 1 then",
      "  $0",
      "end"
    ]
  },
  "goome collapsing": {
    "prefix": "goome-collapsing",
    "description": "collapsing section",
    "body": [
      "if ui:collapsing(\"${1:More stuff}\") then",
      "  $0",
      "end"
    ]
  },
  "goome tree": {
    "prefix": "goome-tree",
    "description": "tree node, open while it returns true",
    "body": [
      "local shown",
      "shown, ${2:src_open} = ui:tree(\"${1:src}\", $2)",
      "if shown then",
      "  $0",
      "  ui:tree_end()",
      "end"
    ]
  },
  "goome progress": {
    "prefix": "goome-progress",
    "description": "progress bar",
    "body": [
      "ui:progress(${1:0.6}, \"${2:60%}\")"
    ]
  },
  "goome color": {
    "prefix": "goome-color",
    "description": "color picker, returns the new color",
    "body": [
      "${2:highlight} = ui:color(\"${1:Highlight}\", $2)"
    ]
  },
  "goome tooltip": {
    "prefix": "goome-tooltip",
    "description": "tooltip for the widget before it",
    "body": [
      "ui:tooltip(\"${1:what it does}\")"
    ]
  },
  "goome row": {
    "prefix": "goome-row",
    "description": "next widgets go side by side",
    "body": [
      "ui:row(${1:2})"
    ]
  },
  "goome same line": {
    "prefix": "goome-same-line",
    "description": "next widget on the same line",
    "body": [
      "ui:same_line()"
    ]
  },
  "goome separator": {
    "prefix": "goome-separator",
    "description": "separator line",
    "body": [
      "ui:separator()"
    ]
  },
  "goome space": {
    "prefix": "goome-space",
    "description": "empty space",
    "body": [
      "ui:space(${1:12})"
    ]
  },
  "goome scroll": {
    "prefix": "goome-scroll",
    "description": "scroll area",
    "body": [
      "if ui:scroll(\"${1:list}\", ${2:150}) then",
      "  $0",
      "end",
      "ui:scroll_end()"
    ]
  },
  "goome split": {
    "prefix": "goome-split",
    "description": "split panes",
    "body": [
      "local shown",
      "shown, ${1:frac} = ui:split(\"${2:main}\", $1, false)",
      "if shown then",
      "  $0",
      "  ui:split_next()",
      "end",
      "ui:split_end()"
    ]
  },
  "goome menubar": {
    "prefix": "goome-menubar",
    "description": "menu bar with a File menu",
    "body": [
      "if ui:menubar() then",
      "  if ui:menu(\"${1:File}\") then",
      "    if ui:menu_item(\"${2:Open}\", \"${3:Ctrl+O}\") then",
      "      $0",
      "    end",
      "    ui:menu_separator()",
      "    if ui:menu_item(\"Quit\", \"Ctrl+Q\") then running = false end",
      "    ui:menu_end()",
      "  end",
      "  ui:menubar_end()",
      "end"
    ]
  },
  "goome popup": {
    "prefix": "goome-popup",
    "description": "button that opens a popup",
    "body": [
      "if ui:button(\"${1:More}\") then ui:popup_open(\"${2:more}\") end",
      "if ui:popup(\"$2\") then",
      "  $0",
      "  ui:popup_end()",
      "end"
    ]
  },
  "goome context": {
    "prefix": "goome-context",
    "description": "right click menu for the widget before it",
    "body": [
      "if ui:context(\"${1:ctx}\") then",
      "  if ui:menu_item(\"${2:Delete}\") then",
      "    $0",
      "  end",
      "  ui:context_end()",
      "end"
    ]
  },
  "goome modal": {
    "prefix": "goome-modal",
    "description": "modal with a Done button",
    "body": [
      "if ui:button(\"${1:Open settings}\") then ${2:settings_open} = true end",
      "local shown",
      "shown, $2 = ui:modal(\"${3:Settings}\", $2)",
      "if shown then",
      "  $0",
      "  if ui:button(\"Done\") then ui:popup_close() end",
      "  ui:modal_end()",
      "end"
    ]
  },
  "goome toast": {
    "prefix": "goome-toast",
    "description": "toast message",
    "body": [
      "ui:toast(\"${1:Saved}\", ${2:2500})"
    ]
  },
  "goome text edit": {
    "prefix": "goome-text-edit",
    "description": "multiline text editor",
    "body": [
      "${2:notes} = ui:text_edit(\"${1:notes}\", $2, ${3:140}, goome.EDIT_WRAP)"
    ]
  },
  "goome table": {
    "prefix": "goome-table",
    "description": "table with sortable columns",
    "body": [
      "if ui:table(\"${1:files}\", 2, ${2:200}, goome.TABLE_SORTABLE + goome.TABLE_STRIPES) then",
      "  ui:table_column(\"${3:Name}\")",
      "  ui:table_column(\"${4:Size}\", 90)",
      "  local changed",
      "  changed, ${5:sort_col}, ${6:sort_desc} = ui:table_sort($5, $6)",
      "  if changed then",
      "  end",
      "  for i = 1, ${7:count} do",
      "    ui:table_row()",
      "    ui:label(tostring(i))",
      "    ui:table_next()",
      "    ui:label(\"$0\")",
      "  end",
      "end",
      "ui:table_end()"
    ]
  },
  "goome drag float": {
    "prefix": "goome-drag-float",
    "description": "drag a number left and right",
    "body": [
      "${2:speed} = ui:drag_float(\"${1:Speed}\", $2, ${3:0.01}, ${4:0}, ${5:10}, \"${6:%.2f}\")"
    ]
  },
  "goome number": {
    "prefix": "goome-number",
    "description": "number box with - and + buttons",
    "body": [
      "${2:amount} = ui:number(\"${1:Amount}\", $2, ${3:1}, \"${4:%.0f}\")"
    ]
  },
  "goome plot": {
    "prefix": "goome-plot",
    "description": "line plot from a table of numbers",
    "body": [
      "ui:plot_lines(\"${1:CPU}\", ${2:values}, ${3:0}, ${4:100}, ${5:90})"
    ]
  },
  "goome plot bars": {
    "prefix": "goome-plot-bars",
    "description": "bar plot from a table of numbers",
    "body": [
      "ui:plot_bars(\"${1:Requests}\", ${2:values}, ${3:0}, ${4:20}, ${5:90})"
    ]
  },
  "goome spinner": {
    "prefix": "goome-spinner",
    "description": "loading spinner",
    "body": [
      "ui:spinner(${1:16})"
    ]
  },
  "goome link": {
    "prefix": "goome-link",
    "description": "clickable link",
    "body": [
      "if ui:link(\"${1:goome docs}\") then",
      "  $0",
      "end"
    ]
  },
  "goome badge": {
    "prefix": "goome-badge",
    "description": "little colored badge",
    "body": [
      "ui:badge(\"${1:new}\", ${2:0xFF6FDC5F})"
    ]
  },
  "goome style": {
    "prefix": "goome-style",
    "description": "push a color and a size, pop them after",
    "body": [
      "ui:push_color(\"${1|accent,bg,panel,border,text,text_dim,hover,active,input_bg|}\", ${2:0xFFFF5050})",
      "ui:push_num(\"${3|radius,pad,gap,border_width,font_size|}\", ${4:4})",
      "$0",
      "ui:pop(2)"
    ]
  },
  "goome style push": {
    "prefix": "goome-style-push",
    "description": "push and pop by hand with the S_ constants",
    "body": [
      "ui:push_color(goome.S_${1|ACCENT,BG,PANEL,BORDER,TEXT,TEXT_DIM,HOVER,ACTIVE,INPUT_BG|}, ${2:0xFFFF5050})",
      "ui:push_num(goome.S_${3|RADIUS,PAD,GAP,BORDER_WIDTH,FONT_SIZE|}, ${4:4})",
      "$0",
      "ui:pop(2)"
    ]
  },
  "goome custom": {
    "prefix": "goome-custom",
    "description": "your own widget, a knob you drag up and down",
    "body": [
      "local ${1:gain} = ui:store(\"$1\", 1)",
      "local _, it = ui:custom(\"$1\", ${2:80}, ${3:80}, goome.ITEM_DRAG_Y + goome.ITEM_FOCUSABLE)",
      "if $1 and it.held then",
      "  $1[1] = math.min(1, math.max(0, $1[1] - it.dy / 200))",
      "end",
      "local c = ui:canvas()",
      "if c and $1 then",
      "  c:arc(it.x + 40, it.y + 40, 30, 6, 2.36, 2.36 + 4.71 * $1[1], ui:theme().accent)",
      "end"
    ]
  },
  "goome offscreen": {
    "prefix": "goome-offscreen",
    "description": "offscreen frame: no window, push a click, save what it drew",
    "body": [
      "local goome = require(\"goome\")",
      "",
      "local g, err = goome.open_offscreen(${1:640}, ${2:480})",
      "if not g then",
      "  io.stderr:write(\"cant open offscreen: \" .. tostring(err) .. \"\\n\")",
      "  os.exit(1)",
      "end",
      "local ui = g:ui()",
      "g:push_click(${3:60}, ${4:60})",
      "for ev in g:events(0) do ui:feed(ev) end",
      "if ui:begin(0) then",
      "  ui:app(\"${5:offscreen}\")",
      "  $0",
      "  ui:app_end()",
      "  ui:finish()",
      "end",
      "local frame = assert(g:last_frame())",
      "frame:save_ppm(\"${6:frame.ppm}\")",
      "ui:close()",
      "g:close()"
    ]
  },
  "goome hotkey": {
    "prefix": "goome-hotkey",
    "description": "global hotkey and where it fires",
    "body": [
      "if not g:hotkey(\"${1:alt+m}\", ${2:1}) then",
      "  print(\"no global hotkeys here: \" .. tostring(g:error()))",
      "end",
      "$0",
      "if ev.type == goome.HOTKEY and ev.id == $2 then",
      "end"
    ]
  },
  "goome theme preset": {
    "prefix": "goome-theme-preset",
    "description": "use a built in theme",
    "body": [
      "ui:theme():preset(goome.PRESET_${1|DARK,LIGHT,MIDNIGHT,PAPER,MINT,HIGH_CONTRAST,ROSE|})"
    ]
  },
  "goome theme make": {
    "prefix": "goome-theme-make",
    "description": "make a theme from one accent color",
    "body": [
      "ui:theme():make(${1:0xFF4FA3FF}, ${2:true}, ${3:10})"
    ]
  },
  "goome ease": {
    "prefix": "goome-ease",
    "description": "raw easing curve, t goes 0 to 1",
    "body": [
      "local ${1:k} = goome.ease(goome.EASE_${2|OUT,IN,IN_OUT,LINEAR,SMOOTH,BACK,SPRING,BOUNCE|}, ${3:t})"
    ]
  },
  "goome anim": {
    "prefix": "goome-anim",
    "description": "animate a number toward a target, call it every frame",
    "body": [
      "local ${1:x} = ${2:ui}:anim(\"${3:panel x}\", ${4:open and 0 or -300}, ${5:250}, goome.EASE_${6|OUT,IN,IN_OUT,LINEAR,SMOOTH,BACK,SPRING,BOUNCE|})"
    ]
  },
  "goome anim color": {
    "prefix": "goome-anim-color",
    "description": "animate a color toward a target, call it every frame",
    "body": [
      "local ${1:bg} = ${2:ui}:anim_color(\"${3:bg}\", ${4:hot and 0xFF3A7BD5 or 0xFF202020}, ${5:150}, goome.EASE_${6|OUT,IN,IN_OUT,LINEAR,SMOOTH,BACK,SPRING,BOUNCE|})"
    ]
  },
  "goome text input": {
    "prefix": "goome-text-input",
    "description": "ime on with the candidate window at the caret, plus typed and composing text",
    "body": [
      "${1:g}:text_input(${2:focused}, {${3:x}, ${4:y}, 2, ${5:20}})",
      "$0",
      "if ev.type == goome.TEXT then",
      "  local ${6:typed} = $1:event_text()",
      "elseif ev.type == goome.PREEDIT then",
      "  local ${7:composing}, ${8:at} = $1:event_text(), $1:preedit_cursor()",
      "end"
    ]
  },
  "goome a11y": {
    "prefix": "goome-a11y",
    "description": "screen reader role, name and value for the next custom item",
    "body": [
      "${1:ui}:a11y_role(goome.ROLE_${2|SLIDER,BUTTON,CHECKBOX,PROGRESS,IMAGE,GROUP|}, \"${3:Volume}\")",
      "$1:a11y_value(${4:\"50%\"})"
    ]
  },
  "goome font fallback": {
    "prefix": "goome-font-fallback",
    "description": "font that falls back to another one for chars it doesnt have",
    "body": [
      "local ${1:font} = assert(goome.font_load(\"${2:Inter.ttf}\"))",
      "$1:fallback(assert(goome.font_load(\"${3:NotoSansCJK.ttc}\")))"
    ]
  },
  "goome text dir": {
    "prefix": "goome-text-dir",
    "description": "force the text direction for all text",
    "body": [
      "goome.text_dir(goome.DIR_${1|RTL,LTR,AUTO|})"
    ]
  }
}

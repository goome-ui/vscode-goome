      "            eprintln!(\"couldnt open a window: {}\", e);",
      "            std::process::exit(1);",
      "        }",
      "    };",
      "    while let Some(mut ui) = app.frame() {",
      "        ui.heading(\"${4:Hello}\");",
      "        $0",
      "    }",
      "}"
    ]
  },
  "goome loop": {
    "prefix": "goome-loop",
    "description": "main loop with poll and pace, only redraws when something changed",
    "body": [
      "let mut pace = goome::Pacer::new(${1:60});",
      "let (mut running, mut dirty) = (true, true);",
      "while running {",
      "    let wait = if dirty || ${2:ui}.animating() { pace.wait() } else { 500 };",
      "    for ev in $2.pump(wait) {",
      "        if ev.kind == goome::QUIT || ev.kind == goome::CLOSE {",
      "            running = false;",
      "        }",
      "        dirty = true;",
      "    }",
      "    if !running {",
      "        break;",
      "    }",
      "    if !dirty && !$2.animating() {",
      "        continue;",
      "    }",
      "    dirty = false;",
      "    let Some(mut f) = $2.begin(0) else { continue };",
      "    $0",
      "}"
    ]
  },

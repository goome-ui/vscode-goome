{
  "goome overlay": {
    "prefix": "goome-overlay",
    "description": "open a see-through overlay with a ui window",
    "body": [
      "use goome::{Goome, Options, WindowState};",
      "",
      "fn main() {",
      "    let mut ui = match Options::new().title(\"${1:my overlay}\").open().and_then(Goome::ui) {",
      "        Ok(u) => u,",
      "        Err(e) => {",
      "            eprintln!(\"couldnt open an overlay: {}\", e);",
      "            std::process::exit(1);",
      "        }",
      "    };",
      "    let mut win = WindowState::new(60.0, 60.0, 280.0, 0.0);",
      "    while win.open {",
      "        for ev in ui.pump(16) {",
      "            if ev.kind == goome::QUIT {",
      "                win.open = false;",
      "            }",
      "        }",
      "        if !win.open {",
      "            continue;",
      "        }",
      "        let Some(mut f) = ui.begin(0) else { continue };",
      "        let mut w = f.window(\"$1\", &mut win, goome::WIN_MOVE | goome::WIN_CLOSE);",
      "        if w.shown() {",
      "            w.label(\"${2:im on top of everything}\");",
      "            $0",
      "        }",
      "    }",
      "}"
    ]
  },
  "goome app": {
    "prefix": "goome-app",

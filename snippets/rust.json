  "goome custom": {
    "prefix": "goome-custom",
    "description": "your own widget, a knob you drag up and down, needs use goome::Draw",
    "body": [
      "let mut ${1:gain} = ui.store(\"$1\", 1)[0];",
      "let it = ui.custom(\"$1\", ${2:80.0}, ${3:80.0}, goome::ITEM_DRAG_Y | goome::ITEM_FOCUSABLE);",
      "if it.held {",
      "    $1 = ($1 - it.dy / 200.0).clamp(0.0, 1.0);",
      "    ui.store(\"$1\", 1)[0] = $1;",
      "}",
      "let accent = ui.theme().accent;",
      "if let Some(mut c) = ui.canvas() {",
      "    c.arc(it.x + 40.0, it.y + 40.0, 30.0, 6.0, 2.36, 2.36 + 4.71 * $1, accent);",
      "}"
    ]
  },
  "goome offscreen": {
    "prefix": "goome-offscreen",
    "description": "offscreen frame: no window, push a click, save what it drew",
    "body": [
      "fn main() -> goome::Result<()> {",
      "    let mut ui = goome::Goome::offscreen(${1:640}, ${2:480}, 1.0)?.ui()?;",
      "    ui.push(&goome::Event::down(${3:60.0}, ${4:60.0}, 1))?;",
      "    ui.push(&goome::Event::up($3, $4, 1))?;",
      "    ui.pump(0);",
      "    if let Some(mut f) = ui.begin(0) {",
      "        let mut a = f.app(Some(\"${5:offscreen}\"), 0);",
      "        $0",
      "    }",
      "    let f = ui.last_frame()?;",
      "    goome::save_ppm(\"${6:frame.ppm}\", f.pixels(), f.w(), f.h(), f.stride())?;",
      "    Ok(())",
      "}"
    ]
  },

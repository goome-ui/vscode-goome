  "goome custom": {
    "prefix": "goome-custom",
    "description": "your own widget, a knob you drag up and down",
    "body": [
      "double *${1:gain} = goome_ui_store(u, \"$1\", 1);",
      "goome_ui_item it;",
      "goome_ui_custom(u, \"$1\", ${2:80}, ${3:80}, GOOME_ITEM_DRAG_Y | GOOME_ITEM_FOCUSABLE, &it);",
      "if ($1 && it.held) $1[0] -= it.dy / 200;",
      "if ($1 && $1[0] < 0) $1[0] = 0;",
      "if ($1 && $1[0] > 1) $1[0] = 1;",
      "goome_canvas *c = goome_ui_canvas(u);",
      "if (c && $1) goome_draw_arc(c, it.x + 40, it.y + 40, 30, 6, 2.36, 2.36 + 4.71 * $1[0], goome_ui_theme(u)->accent);"
    ]
  },
  "goome offscreen": {
    "prefix": "goome-offscreen",
    "description": "offscreen frame: no window, push a click, save what it drew",
    "body": [
      "int err;",
      "goome *g = goome_open(&(goome_opts){.mode = GOOME_MODE_OFFSCREEN, .width = ${1:640}, .height = ${2:480}, .scale = 1}, &err);",
      "if (!g) {",
      "\tfprintf(stderr, \"cant open offscreen: %s\\n\", goome_strerror(err));",
      "\treturn 1;",
      "}",
      "goome_ui *u = goome_ui_new(g);",
      "goome_event click = {.type = GOOME_DOWN, .x = ${3:60}, .y = ${4:60}, .button = 1};",
      "goome_push(g, &click);",
      "click.type = GOOME_UP;",
      "goome_push(g, &click);",
      "goome_event ev;",
      "while (goome_poll(g, &ev, 0) > 0) goome_ui_feed(u, &ev);",
      "if (goome_ui_begin(u, 0)) {",
      "\tgoome_ui_app(u, \"${5:offscreen}\", 0);",
      "\t$0",
      "\tgoome_ui_app_end(u);",
      "\tgoome_ui_end(u);",
      "}",
      "goome_image frame;",
      "if (goome_frame(g, &frame) == GOOME_OK) goome_save_ppm(\"${6:frame.ppm}\", frame.px, frame.w, frame.h, frame.stride);",
      "goome_ui_free(u);",
      "goome_close(g);"
    ]
  },

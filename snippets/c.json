      "\tgoome_ui_label(u, \"${3:hello}\");",
      "\tif (goome_ui_button(u, \"${4:Click me}\")) {",
      "\t\t$0",
      "\t}",
      "}",
      "goome_ui_window_end(u);"
    ]
  },
  "goome canvas": {
    "prefix": "goome-canvas",
    "description": "draw on the overlay yourself, no ui",
    "body": [
      "goome_canvas *c = goome_begin(${1:g}, 0);",
      "if (c) {",
      "\tgoome_clear(c);",
      "\tgoome_draw_round_rect(c, ${2:40}, ${3:40}, ${4:200}, ${5:80}, 10, 0xEC1B1D22);",
      "\tgoome_draw_text(c, $2 + 12, $3 + 12, \"${6:hello}\", 1, 0xFFE9EBEE);",
      "\t$0",
      "\tgoome_rect hit = {$2, $3, $4, $5};",
      "\tgoome_end($1, c, &hit, 1);",
      "}"
    ]
  },

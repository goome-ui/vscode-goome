{
  "goome include": {
    "prefix": "goome-include",
    "description": "goome.h with the implementation in this file",
    "body": [
      "#define GOOME_IMPLEMENTATION",
      "#include \"goome.h\"",
      "$0"
    ]
  },
  "goome overlay": {
    "prefix": "goome-overlay",
    "description": "open a see-through overlay with a ui window",
    "body": [
      "#define GOOME_IMPLEMENTATION",
      "#include \"goome.h\"",
      "#include <stdio.h>",
      "",
      "int main(void)",
      "{",
      "\tint err;",
      "\tgoome *g = goome_open(&(goome_opts){.title = \"${1:my overlay}\"}, &err);",
      "\tif (!g) {",
      "\t\tfprintf(stderr, \"cant open an overlay: %s\\n\", goome_strerror(err));",
      "\t\treturn 1;",
      "\t}",
      "\tgoome_ui *u = goome_ui_new(g);",
      "\tdouble x = 60, y = 60, w = 280, h = 0;",
      "\tint open = 1;",
      "\twhile (open) {",
      "\t\tgoome_event ev;",
      "\t\twhile (goome_poll(g, &ev, 16) > 0) {",
      "\t\t\tif (ev.type == GOOME_QUIT) open = 0;",
      "\t\t\tgoome_ui_feed(u, &ev);",
      "\t\t}",
      "\t\tif (!open || !goome_ui_begin(u, 0)) continue;",
      "\t\tif (goome_ui_window(u, \"$1\", &x, &y, &w, &h, GOOME_WIN_MOVE | GOOME_WIN_CLOSE, &open)) {",
      "\t\t\tgoome_ui_label(u, \"${2:im on top of everything}\");",
      "\t\t\t$0",
      "\t\t}",
      "\t\tgoome_ui_window_end(u);",
      "\t\tgoome_ui_end(u);",
      "\t}",
      "\tgoome_ui_free(u);",
      "\tgoome_close(g);",
      "\treturn 0;",
      "}"
    ]
  },
  "goome app": {
    "prefix": "goome-app",
    "description": "open a normal app window that the ui fills",
    "body": [
      "#define GOOME_IMPLEMENTATION",
      "#include \"goome.h\"",
      "#include <stdio.h>",
      "",
      "int main(void)",
      "{",
      "\tint err;",
      "\tgoome *g = goome_open_app(\"${1:My App}\", ${2:960}, ${3:640}, &err);",
      "\tif (!g) {",
      "\t\tfprintf(stderr, \"cant open a window: %s\\n\", goome_strerror(err));",
      "\t\treturn 1;",
      "\t}",
      "\tgoome_ui *u = goome_ui_new(g);",
      "\tint running = 1;",
      "\twhile (running) {",
      "\t\tgoome_event ev;",
      "\t\twhile (goome_poll(g, &ev, 16) > 0) {",
      "\t\t\tif (ev.type == GOOME_QUIT || ev.type == GOOME_CLOSE) running = 0;",
      "\t\t\tgoome_ui_feed(u, &ev);",
      "\t\t}",
      "\t\tif (!running || !goome_ui_begin(u, 0)) continue;",
      "\t\tgoome_ui_app(u, \"$1\", 0);",
      "\t\tgoome_ui_heading(u, \"${4:Hello}\");",
      "\t\t$0",
      "\t\tgoome_ui_app_end(u);",
      "\t\tgoome_ui_end(u);",
      "\t}",
      "\tgoome_ui_free(u);",
      "\tgoome_close(g);",
      "\treturn 0;",
      "}"
    ]
  },
  "goome loop": {
    "prefix": "goome-loop",
    "description": "main loop with poll and pace, only redraws when something changed",
    "body": [
      "goome_pacer pace = {0};",
      "int running = 1, dirty = 1;",
      "while (running) {",
      "\tgoome_event ev;",
      "\tint wait = dirty || goome_ui_animating(${1:u}) ? goome_pace(&pace, ${2:60}) : 500;",
      "\twhile (goome_poll(${3:g}, &ev, wait) > 0) {",
      "\t\tif (ev.type == GOOME_QUIT || ev.type == GOOME_CLOSE) running = 0;",
      "\t\tgoome_ui_feed($1, &ev);",
      "\t\tdirty = 1, wait = 0;",
      "\t}",
      "\tif (!running) break;",
      "\tif (!dirty && !goome_ui_animating($1)) continue;",
      "\tdirty = 0;",
      "\tif (!goome_ui_begin($1, 0)) continue;",
      "\t$0",
      "\tgoome_ui_end($1);",
      "}"
    ]
  },
  "goome window": {
    "prefix": "goome-window",
    "description": "ui window with a label and a button",

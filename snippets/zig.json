      "    u.label(\"${3:hello}\");",
      "    if (u.button(\"${4:Click me}\")) {",
      "        $0",
      "    }",
      "}",
      "u.windowEnd();"
    ]
  },
  "goome canvas": {
    "prefix": "goome-canvas",
    "description": "draw on the overlay yourself, no ui",
    "body": [

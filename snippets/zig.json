{
  "goome overlay": {
    "prefix": "goome-overlay",
    "description": "open a see-through overlay with a ui window",
    "body": [
      "const std = @import(\"std\");",
      "const goome = @import(\"goome\");",
      "",
      "pub fn main() !void {",
      "    const g = goome.Goome.open(.{ .title = \"${1:my overlay}\" }) catch |e| {",
      "        std.debug.print(\"couldnt open an overlay: {s}\\n\", .{goome.strerror(goome.errorCode(e))});",
      "        std.process.exit(1);",
      "    };",
      "    defer g.deinit();",
      "    const u = try g.ui();",
      "    defer u.deinit();",
      "    var win: goome.Window = .{ .x = 60, .y = 60, .w = 280 };",
      "    while (win.isOpen()) {",
      "        while (try g.poll(16)) |ev| {",
      "            if (ev.kind == .quit) win.setOpen(false);",
      "            _ = u.feed(ev);",
      "        }",
      "        if (!win.isOpen()) break;",
      "        _ = u.begin(0) orelse continue;",
      "        if (u.window(\"$1\", &win, goome.win.move | goome.win.close)) {",
      "            u.label(\"${2:im on top of everything}\");",
      "            $0",
      "        }",
      "        u.windowEnd();",
      "        u.end();",
      "    }",
      "}"
    ]
  },
  "goome app": {
    "prefix": "goome-app",
    "description": "open a normal app window that the ui fills",
    "body": [
      "const std = @import(\"std\");",
      "const goome = @import(\"goome\");",
      "",
      "pub fn main() !void {",
      "    const g = goome.Goome.openApp(\"${1:My App}\", ${2:960}, ${3:640}) catch |e| {",
      "        std.debug.print(\"couldnt open a window: {s}\\n\", .{goome.strerror(goome.errorCode(e))});",
      "        std.process.exit(1);",
      "    };",
      "    defer g.deinit();",
      "    const u = try g.ui();",
      "    defer u.deinit();",
      "    var running = true;",
      "    while (running) {",
      "        while (try g.poll(16)) |ev| {",
      "            if (ev.kind == .quit or ev.kind == .close) running = false;",
      "            _ = u.feed(ev);",
      "        }",
      "        if (!running) break;",
      "        _ = u.begin(0) orelse continue;",
      "        _ = u.app(\"$1\", 0);",
      "        u.heading(\"${4:Hello}\");",
      "        $0",
      "        u.appEnd();",
      "        u.end();",
      "    }",
      "}"
    ]
  },
  "goome loop": {
    "prefix": "goome-loop",
    "description": "main loop with poll and pace, only redraws when something changed",
    "body": [
      "var pace: goome.Pacer = .{};",
      "var running = true;",
      "var dirty = true;",
      "while (running) {",
      "    var wait: i32 = if (dirty or ${1:u}.animating()) pace.wait(${2:60}) else 500;",
      "    while (try ${3:g}.poll(wait)) |ev| {",
      "        if (ev.kind == .quit or ev.kind == .close) running = false;",
      "        _ = $1.feed(ev);",
      "        dirty = true;",
      "        wait = 0;",
      "    }",
      "    if (!running) break;",
      "    if (!dirty and !$1.animating()) continue;",
      "    dirty = false;",
      "    _ = $1.begin(0) orelse continue;",
      "    $0",
      "    $1.end();",
      "}"
    ]
  },
  "goome window": {
    "prefix": "goome-window",
    "description": "ui window with a label and a button",
    "body": [

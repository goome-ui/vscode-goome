  "goome custom": {
    "prefix": "goome-custom",
    "description": "your own widget, a knob you drag up and down",
    "body": [
      "var it: goome.Item = .{};",
      "_ = u.custom(\"${1:gain}\", ${2:80}, ${3:80}, goome.c.GOOME_ITEM_DRAG_Y | goome.c.GOOME_ITEM_FOCUSABLE, &it);",
      "if (u.store(\"$1\", 1)) |$1| {",
      "    if (it.held != 0) $1[0] = @min(1, @max(0, $1[0] - it.dy / 200));",
      "    if (u.canvas()) |cv| cv.arc(it.x + 40, it.y + 40, 30, 6, 2.36, 2.36 + 4.71 * $1[0], u.theme().accent);",
      "}"
    ]
  },
  "goome offscreen": {
    "prefix": "goome-offscreen",
    "description": "offscreen frame: no window, push a click, save what it drew",
    "body": [
      "const std = @import(\"std\");",
      "const goome = @import(\"goome\");",
      "",
      "pub fn main() !void {",
      "    const g = goome.Goome.openOffscreen(${1:640}, ${2:480}, 1) catch |e| {",
      "        std.debug.print(\"couldnt open offscreen: {s}\\n\", .{goome.strerror(goome.errorCode(e))});",
      "        std.process.exit(1);",
      "    };",
      "    defer g.deinit();",
      "    const u = try g.ui();",
      "    defer u.deinit();",
      "    try g.pushClick(${3:60}, ${4:60});",
      "    while (try g.poll(0)) |ev| _ = u.feed(ev);",
      "    if (u.begin(0) != null) {",
      "        _ = u.app(\"${5:offscreen}\", 0);",
      "        $0",
      "        u.appEnd();",
      "        u.end();",
      "    }",
      "    const frame = try g.frame();",
      "    try frame.savePpm(\"${6:frame.ppm}\");",
      "}"
    ]
  },

      "    cv.clear();",
      "    cv.roundRect(${2:40}, ${3:40}, ${4:200}, ${5:80}, 10, 0xEC1B1D22);",
      "    _ = cv.text($2 + 12, $3 + 12, \"${6:hello}\", true, 0xFFE9EBEE);",
      "    $0",
      "    try $1.end(cv, &.{goome.rect($2, $3, $4, $5)});",
      "}"
    ]
  },

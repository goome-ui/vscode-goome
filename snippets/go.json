{
  "goome overlay": {
    "prefix": "goome-overlay",
    "description": "open a see-through overlay with a ui window",
    "body": [
      "package main",
      "",
      "import (",
      "\t\"fmt\"",
      "\t\"os\"",
      "",
      "\t\"github.com/goome-ui/go-goome\"",
      ")",
      "",
      "func main() {",
      "\tg, err := goome.Open(goome.Options{Title: \"${1:my overlay}\"})",
      "\tif err != nil {",
      "\t\tfmt.Fprintln(os.Stderr, \"couldnt open an overlay:\", err)",
      "\t\tos.Exit(1)",
      "\t}",
      "\tdefer g.Close()",
      "\tui, err := g.NewUI()",
      "\tif err != nil {",
      "\t\tfmt.Fprintln(os.Stderr, \"couldnt make a ui:\", err)",
      "\t\tos.Exit(1)",
      "\t}",
      "\tdefer ui.Free()",
      "\twin := goome.NewWindow(60, 60, 280, 0)",
      "\tfor !win.Closed {",
      "\t\tfor ev := range g.Events(16) {",
      "\t\t\tif ev.Type == goome.EventQuit {",
      "\t\t\t\twin.Closed = true",
      "\t\t\t}",
      "\t\t\tui.Feed(ev)",
      "\t\t}",
      "\t\tif win.Closed {",
      "\t\t\tbreak",
      "\t\t}",
      "\t\tif ui.Begin(0) == nil {",
      "\t\t\tui.End()",
      "\t\t\tcontinue",
      "\t\t}",
      "\t\tif ui.Window(\"$1\", win, goome.WinMove|goome.WinClose) {",
      "\t\t\tui.Label(\"${2:im on top of everything}\")",
      "\t\t\t$0",
      "\t\t}",
      "\t\tui.End()",
      "\t\tui.End()",
      "\t}",
      "}"
    ]
  },
  "goome app": {
    "prefix": "goome-app",
    "description": "open a normal app window that the ui fills",
    "body": [
      "package main",
      "",
      "import (",
      "\t\"fmt\"",
      "\t\"os\"",
      "",
      "\t\"github.com/goome-ui/go-goome\"",
      ")",
      "",
      "func main() {",
      "\tg, err := goome.OpenApp(\"${1:My App}\", ${2:960}, ${3:640})",
      "\tif err != nil {",
      "\t\tfmt.Fprintln(os.Stderr, \"couldnt open a window:\", err)",
      "\t\tos.Exit(1)",
      "\t}",
      "\tdefer g.Close()",
      "\tui, err := g.NewUI()",
      "\tif err != nil {",
      "\t\tfmt.Fprintln(os.Stderr, \"couldnt make a ui:\", err)",
      "\t\tos.Exit(1)",
      "\t}",
      "\tdefer ui.Free()",
      "\tfor running := true; running; {",
      "\t\tfor ev := range g.Events(16) {",
      "\t\t\tif ev.Type == goome.EventQuit || ev.Type == goome.EventClose {",
      "\t\t\t\trunning = false",
      "\t\t\t}",
      "\t\t\tui.Feed(ev)",
      "\t\t}",
      "\t\tif !running {",
      "\t\t\tbreak",
      "\t\t}",
      "\t\tif ui.Begin(0) == nil {",
      "\t\t\tui.End()",
      "\t\t\tcontinue",
      "\t\t}",
      "\t\tui.App(\"$1\", 0)",
      "\t\tui.Heading(\"${4:Hello}\")",
      "\t\t$0",
      "\t\tui.End()",
      "\t\tui.End()",
      "\t}",
      "}"
    ]
  },
  "goome loop": {
    "prefix": "goome-loop",
    "description": "main loop with poll and pace, only redraws when something changed",
    "body": [
      "pace := goome.NewPacer(${1:60})",
      "defer pace.Free()",
      "running, dirty := true, true",
      "for running {",
      "\twait := 500",
      "\tif dirty || ${2:ui}.Animating() {",
      "\t\twait = pace.Wait()",
      "\t}",
      "\tfor ev := range ${3:g}.Events(wait) {",
      "\t\tif ev.Type == goome.EventQuit || ev.Type == goome.EventClose {",
      "\t\t\trunning = false",
      "\t\t}",
      "\t\t$2.Feed(ev)",
      "\t\tdirty = true",
      "\t}",
      "\tif !running {",
      "\t\tbreak",
      "\t}",
      "\tif !dirty && !$2.Animating() {",
      "\t\tcontinue",
      "\t}",
      "\tdirty = false",
      "\tif $2.Begin(0) == nil {",
      "\t\t$2.End()",
      "\t\tcontinue",
      "\t}",
      "\t$0",
      "\t$2.End()",
      "}"
    ]
  },
  "goome window": {
    "prefix": "goome-window",
    "description": "ui window with a label and a button, win is a *Window",
    "body": [
      "if ui.Window(\"${1:Window}\", ${2:win}, goome.WinMove|goome.WinResize|goome.WinCollapse) {",
      "\tui.Label(\"${3:hello}\")",

  "goome custom": {
    "prefix": "goome-custom",
    "description": "your own widget, a knob you drag up and down",
    "body": [
      "${1:gain} := ui.Store(\"$1\", 1)",
      "it, _ := ui.Custom(\"$1\", ${2:80}, ${3:80}, goome.ItemDragY|goome.ItemFocusable)",
      "if $1 != nil {",
      "\tif it.Held {",
      "\t\t$1[0] = min(1, max(0, $1[0]-it.DY/200))",
      "\t}",
      "\tif c := ui.Canvas(); c != nil {",
      "\t\tc.Arc(it.X+40, it.Y+40, 30, 6, 2.36, 2.36+4.71*$1[0], ui.Theme().Accent)",
      "\t}",
      "}"
    ]
  },
  "goome offscreen": {
    "prefix": "goome-offscreen",
    "description": "offscreen frame: no window, push a click, save what it drew",
    "body": [
      "package main",
      "",
      "import (",
      "\t\"fmt\"",
      "\t\"os\"",
      "",
      "\t\"github.com/goome-ui/go-goome\"",
      ")",
      "",
      "func main() {",
      "\tg, err := goome.OpenOffscreen(${1:640}, ${2:480}, 1)",
      "\tif err != nil {",
      "\t\tfmt.Fprintln(os.Stderr, \"couldnt open an offscreen frame:\", err)",
      "\t\tos.Exit(1)",
      "\t}",
      "\tdefer g.Close()",
      "\tui, err := g.NewUI()",
      "\tif err != nil {",
      "\t\tfmt.Fprintln(os.Stderr, \"couldnt make a ui:\", err)",
      "\t\tos.Exit(1)",
      "\t}",
      "\tdefer ui.Free()",
      "\tg.PushClick(${3:60}, ${4:60})",
      "\tfor ev := range g.Events(0) {",
      "\t\tui.Feed(ev)",
      "\t}",
      "\tif ui.Begin(0) != nil {",
      "\t\tui.App(\"${5:offscreen}\", 0)",
      "\t\t$0",
      "\t\tui.End()",
      "\t}",
      "\tui.End()",
      "\tframe, err := g.LastFrame()",
      "\tif err == nil {",
      "\t\terr = frame.SavePPM(\"${6:frame.ppm}\")",
      "\t}",
      "\tif err != nil {",
      "\t\tfmt.Fprintln(os.Stderr, \"couldnt save the frame:\", err)",
      "\t\tos.Exit(1)",
      "\t}",
      "}"
    ]
  },

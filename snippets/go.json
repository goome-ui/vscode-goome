      "\t}",
      "}",
      "ui.End()"
    ]
  },
  "goome canvas": {
    "prefix": "goome-canvas",
    "description": "draw on the overlay yourself, no ui",
    "body": [
      "c := ${1:g}.Begin(0)",
      "if c != nil {",
      "\tc.Clear()",
      "\tc.RoundRect(${2:40}, ${3:40}, ${4:200}, ${5:80}, 10, 0xEC1B1D22)",
      "\tc.Text($2+12, $3+12, \"${6:hello}\", true, 0xFFE9EBEE)",
      "\t$0",
      "\tc.Hit($2, $3, $4, $5)",
      "\t$1.End(c)",
      "}"
    ]
  },

{
  "goome overlay": {
    "prefix": "goome-overlay",
    "description": "open a see-through overlay with a ui window",
    "body": [
      "using GoomeSharp;",
      "",
      "Goome g;",
      "try { g = new Goome(new GoomeOptions { Title = \"${1:my overlay}\" }); }",
      "catch (GoomeException e)",
      "{",
      "\tConsole.Error.WriteLine(\"couldnt open an overlay: \" + e.Message);",
      "\treturn 1;",
      "}",
      "using (g)",
      "using (var ui = new Ui(g))",
      "{",
      "\tdouble x = 60, y = 60, w = 280, h = 0;",
      "\tbool open = true;",
      "\twhile (open)",
      "\t{",
      "\t\twhile (g.Poll(out var ev, 16))",
      "\t\t{",
      "\t\t\tif (ev.Type == EventType.Quit) open = false;",
      "\t\t\tui.Feed(ev);",
      "\t\t}",
      "\t\tif (!open || ui.Begin(0) == null) continue;",
      "\t\tif (ui.Window(\"$1\", ref x, ref y, ref w, ref h, WindowFlags.Move | WindowFlags.Close, ref open))",
      "\t\t{",
      "\t\t\tui.Label(\"${2:im on top of everything}\");",
      "\t\t\t$0",
      "\t\t}",
      "\t\tui.WindowEnd();",
      "\t\tui.End();",
      "\t}",
      "}",
      "return 0;"
    ]
  },
  "goome app": {
    "prefix": "goome-app",
    "description": "open a normal app window that the ui fills",
    "body": [
      "using GoomeSharp;",
      "",
      "Goome g;",
      "try { g = Goome.OpenApp(\"${1:My App}\", ${2:960}, ${3:640}); }",
      "catch (GoomeException e)",
      "{",
      "\tConsole.Error.WriteLine(\"couldnt open a window: \" + e.Message);",
      "\treturn 1;",
      "}",
      "using (g)",
      "using (var ui = new Ui(g))",
      "{",
      "\tbool running = true;",
      "\twhile (running)",
      "\t{",
      "\t\twhile (g.Poll(out var ev, 16))",
      "\t\t{",
      "\t\t\tif (ev.Type == EventType.Quit || ev.Type == EventType.Close) running = false;",
      "\t\t\tui.Feed(ev);",
      "\t\t}",
      "\t\tif (!running || ui.Begin(0) == null) continue;",
      "\t\tui.App(\"$1\");",
      "\t\tui.Heading(\"${4:Hello}\");",
      "\t\t$0",
      "\t\tui.AppEnd();",
      "\t\tui.End();",
      "\t}",
      "}",
      "return 0;"
    ]
  },
  "goome loop": {
    "prefix": "goome-loop",
    "description": "main loop with poll and pace, only redraws when something changed",
    "body": [
      "bool running = true, dirty = true;",
      "var pace = new Pacer();",
      "while (running)",
      "{",
      "\tint wait = dirty || ${1:ui}.Animating ? pace.Pace(${2:60}) : 500;",
      "\twhile (${3:g}.Poll(out var ev, wait))",
      "\t{",
      "\t\tif (ev.Type == EventType.Quit || ev.Type == EventType.Close) running = false;",
      "\t\t$1.Feed(ev);",
      "\t\tdirty = true;",
      "\t\twait = 0;",
      "\t}",
      "\tif (!running) break;",
      "\tif (!dirty && !$1.Animating) continue;",
      "\tdirty = false;",
      "\tif ($1.Begin(0) == null) continue;",
      "\t$0",
      "\t$1.End();",
      "}"
    ]
  },
  "goome window": {
    "prefix": "goome-window",
    "description": "ui window with a label and a button",
    "body": [
      "if (ui.Window(\"${1:Window}\", ref ${2:winX}, ref ${3:winY}, ref ${4:winW}, ref ${5:winH}, WindowFlags.Move | WindowFlags.Resize | WindowFlags.Collapse))",
      "{",
      "\tui.Label(\"${6:hello}\");",
      "\tif (ui.Button(\"${7:Click me}\"))",
      "\t{",
      "\t\t$0",
      "\t}",
      "}",
      "ui.WindowEnd();"
    ]
  },
  "goome canvas": {
    "prefix": "goome-canvas",
    "description": "draw on the overlay yourself, no ui",
    "body": [
      "var c = ${1:g}.Begin(0);",
      "if (c != null)",
      "{",
      "\tc.Clear();",
      "\tc.DrawRoundRect(${2:40}, ${3:40}, ${4:200}, ${5:80}, 10, 0xEC1B1D22u);",
      "\tc.DrawText($2 + 12, $3 + 12, \"${6:hello}\", true, 0xFFE9EBEEu);",
      "\t$0",
      "\t$1.End(c, new Rect($2, $3, $4, $5));",
      "}"
    ]
  },

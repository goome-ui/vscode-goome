  "goome custom": {
    "prefix": "goome-custom",
    "description": "your own widget, a knob you drag up and down",
    "body": [
      "var ${1:gain} = ui.Store(\"$1\", 1);",
      "ui.Custom(\"$1\", ${2:80}, ${3:80}, ItemFlags.DragY | ItemFlags.Focusable, out var it);",
      "if (it.Held) $1[0] = Math.Max(0, Math.Min(1, $1[0] - it.Dy / 200));",
      "ui.Canvas()?.DrawArc(it.X + 40, it.Y + 40, 30, 6, 2.36, 2.36 + 4.71 * $1[0], ui.Theme.Accent);"
    ]
  },
  "goome offscreen": {
    "prefix": "goome-offscreen",
    "description": "offscreen frame: no window, push a click, save what it drew",
    "body": [
      "using (var g = Goome.OpenOffscreen(${1:640}, ${2:480}))",
      "using (var ui = new Ui(g))",
      "{",
      "\tg.Push(Event.Down(${3:60}, ${4:60}));",
      "\tg.Push(Event.Up($3, $4));",
      "\twhile (g.Poll(out var ev, 0)) ui.Feed(ev);",
      "\tif (ui.Begin(0) != null)",
      "\t{",
      "\t\tui.App(\"${5:offscreen}\");",
      "\t\t$0",
      "\t\tui.AppEnd();",
      "\t\tui.End();",
      "\t}",
      "\tGoome.SavePpm(\"${6:frame.ppm}\", g.Frame());",
      "}"
    ]
  },
